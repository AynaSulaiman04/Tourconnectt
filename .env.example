# ══════════════════════════════════════════════════════════════════════
#  Tour ConnecTT — environment configuration
#
#  TEMPLATE. Copy to .env.local and fill in. Never put real keys here --
#  this file IS committed. .env.local is git-ignored.
#
#  FOR THE LIVE SITE (tourconnectt.com):
#    Vercel → Settings → Environment Variables → Import .env → paste this file
#    → set Environment = Production → redeploy.
#    Then change the four values marked  ▶ PRODUCTION  below.
#
#  Anything left blank is optional unless its comment says otherwise.
#
#  Keep this file in step with .env.local when you add a variable.
# ══════════════════════════════════════════════════════════════════════


# ── Database (Supabase) ───────────────────────────────────────── required ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by: npm run db:migrate, and the seed scripts.
# DIRECT_URL is preferred for schema changes; both may hold the same value.
DATABASE_URL=
DIRECT_URL=


# ── Site address ──────────────────────────────────────────────── required ──
# ▶ PRODUCTION: https://tourconnectt.com   (no trailing slash)
# Builds every link that leaves the app: email links, payment returns.
NEXT_PUBLIC_APP_URL=


# ── Email ─────────────────────────────────────────────────────── required ──
# Sends every enquiry confirmation, operator notification and password reset.
#
# SMTP_PASS must be a 16-character Gmail APP PASSWORD, not the account
# password. Create one at myaccount.google.com/apppasswords (2-Step
# Verification must be on first). Gmail only lets you send as the account you
# sign in with, so SMTP_USER and SMTP_FROM must match.
#
# Verify with:  npm run mail:test
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional alternative to SMTP_PASS; leave blank if SMTP_PASS is set.
SMTP_APP_PASSWORD=

# Where admin alerts are delivered.
ADMIN_NOTIFICATION_EMAIL=


# ── AI concierge ──────────────────────────────────────── one key required ──
# Groq is tried first, OpenAI second. Set CONCIERGE_AI_PROVIDER=openai to
# reverse that. Without either key the concierge shows an unavailable notice.
GROQ_API_KEY=
OPENAI_API_KEY=
CONCIERGE_AI_PROVIDER=
OPENAI_MODEL=


# ── Google Calendar (operator sync) ───────────────────────────── optional ──
# ▶ PRODUCTION: GOOGLE_REDIRECT_URI=https://tourconnectt.com/api/google/calendar/callback
# The redirect URI must be listed character-for-character in Google Cloud
# Console → Credentials → your OAuth client → Authorised redirect URIs.
# Add BOTH the localhost and the live one there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=


# ── Payments (WiPay) ──────────────────────── required to take any payment ──
# ▶ PRODUCTION: WIPAY_ENVIRONMENT=live   (sandbox takes no real money)
#
# The values below are PLACEHOLDERS. Payments fail, even in sandbox, until
# WiPay issues you real credentials.
#   WIPAY_ACCOUNT_NUMBER — digits only; WIPAY_DEVELOPER_ID is the older name
#   WIPAY_API_KEY        — WIPAY_BUSINESS_KEY is the older name
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_DEVELOPER_ID=
WIPAY_BUSINESS_KEY=
WIPAY_ENVIRONMENT=
WIPAY_CURRENCY=
WIPAY_COUNTRY_CODE=
WIPAY_API_BASE_URL=

# Verifies WiPay's payment webhooks. Blank means callbacks are not verified.
WIPAY_WEBHOOK_SECRET=


# ── Security secrets ──────────────────────────────────────────────────────
# Random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# CRON_SECRET is REQUIRED in production: without it the scheduled-email and
# calendar-sync endpoints return 401, so reminders and review requests never
# send. The rest have safe fallbacks but should be set for a live site.
CRON_SECRET=
ICAL_FEED_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
INQUIRY_RATE_LIMIT_SECRET=
CONCIERGE_IP_SALT=


# ── Seed / maintenance scripts ────────────────── local use only, optional ──
# Only read when you run these by hand. Never needed in Vercel.
#   npm run seed:admin            ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_FULL_NAME
#   npm run seed:demo             DEMO_* below
#   npm run cleanup:test-accounts CLEANUP_*
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_NAME=
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_NAME=
DEMO_TRAVELER_EMAIL=
DEMO_TRAVELER_NAME=
DEMO_ACCOUNT_PASSWORD=
DEMO_DEMOTE_LEGACY_LISTINGS=
CLEANUP_APPLY=
CLEANUP_EXTRA_EMAILS=
